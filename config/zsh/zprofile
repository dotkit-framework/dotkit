# dotkit base. Your own lines go in ~/.zprofile.local, which this file sources
# before it puts the global tool directories first in PATH.

if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

if [[ -r ~/.zprofile.local ]]; then
  source ~/.zprofile.local
fi

# Drop the mise shims: `mise activate` supplies the tools in interactive shells.
path=( ${path:#$HOME/.local/share/mise/shims} )

# Nix owns the global CLIs. mise owns the runtimes and overrides them inside a project.
# DOTKIT_TOOL_PATH comes from dotkit.toolPath through hm-session-vars.sh.
typeset -U path PATH
path=( ${(s.:.)DOTKIT_TOOL_PATH} $path )

# Non-interactive login shells do not read .zshrc.
if [[ ! -o interactive ]] && (( $+commands[mise] )); then
  eval "$(mise activate zsh)"
fi
