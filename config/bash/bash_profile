# shellcheck shell=bash
# dotkit base for bash login shells: `bash -l`, scripts with #!/bin/bash -l,
# `ssh host bash -l`. It does what config/zsh/zprofile does for zsh. Your own
# lines go in ~/.bash_profile.local, which this file sources before it puts
# the global tool directories first in PATH. An interactive shell then reads
# ~/.bashrc. It must work with the macOS Bash 3.2.

# The Home Manager variables, among them DOTKIT_TOOL_PATH and
# NPM_CONFIG_GLOBALCONFIG. config/zsh/zshenv loads them for zsh, with the same
# rules: refresh them also when a long-running parent (a tmux or herdr server,
# an editor) started before the last apply, but keep the SDK selections that
# the caller set, for example JAVA_HOME of a project.
if [[ -r /etc/profiles/per-user/$USER/etc/profile.d/hm-session-vars.sh ]]; then
  _dotkit_java_home=${JAVA_HOME-} _dotkit_java_home_set=${JAVA_HOME+1}
  _dotkit_android_home=${ANDROID_HOME-} _dotkit_android_home_set=${ANDROID_HOME+1}
  unset __HM_SESS_VARS_SOURCED
  # shellcheck source=/dev/null
  . "/etc/profiles/per-user/$USER/etc/profile.d/hm-session-vars.sh"
  if [[ -n $_dotkit_java_home_set ]]; then
    if [[ -z $_dotkit_java_home || -d $_dotkit_java_home ]]; then
      export JAVA_HOME=$_dotkit_java_home
    elif [[ $_dotkit_java_home != "$JAVA_HOME" ]]; then
      printf 'JAVA_HOME is not a directory: %s. Using Home Manager default: %s.\n' "$_dotkit_java_home" "$JAVA_HOME" >&2
    fi
  fi
  if [[ -n $_dotkit_android_home_set ]]; then
    if [[ -z $_dotkit_android_home || -d $_dotkit_android_home ]]; then
      export ANDROID_HOME=$_dotkit_android_home
    elif [[ $_dotkit_android_home != "$ANDROID_HOME" ]]; then
      printf 'ANDROID_HOME is not a directory: %s. Using Home Manager default: %s.\n' "$_dotkit_android_home" \
        "$ANDROID_HOME" >&2
    fi
  fi
  # The file adds its directories to TERMINFO_DIRS each time. Keep the first of
  # each entry, also of an empty one, which selects the system database.
  _dotkit_terminfo='' _dotkit_seen='|' _dotkit_count=0
  IFS=: read -r -a _dotkit_dirs <<<"${TERMINFO_DIRS-}"
  for _dotkit_dir in "${_dotkit_dirs[@]}"; do
    case $_dotkit_seen in *"|$_dotkit_dir|"*) continue ;; esac
    _dotkit_seen=$_dotkit_seen$_dotkit_dir'|'
    if ((_dotkit_count)); then _dotkit_terminfo=$_dotkit_terminfo:$_dotkit_dir; else _dotkit_terminfo=$_dotkit_dir; fi
    _dotkit_count=1
  done
  [[ -z ${TERMINFO_DIRS-} ]] || export TERMINFO_DIRS=$_dotkit_terminfo
  unset _dotkit_java_home _dotkit_java_home_set _dotkit_android_home _dotkit_android_home_set \
    _dotkit_terminfo _dotkit_seen _dotkit_count _dotkit_dirs _dotkit_dir
fi

# A login shell that a dotkit shell started keeps the directories that were
# before the global tool directories in PATH, as in config/zsh/zprofile.
# /etc/profile ran path_helper before this file, and it moved the directories
# of /etc/paths and /etc/paths.d to the front, so skip those.
_dotkit_first=
if [[ -n ${__DOTKIT_PROFILE_DONE-} ]]; then
  _dotkit_profile_first() {
    local system=: file dir
    local -a dirs
    for file in /etc/paths /etc/paths.d/*; do
      [[ -f $file ]] || continue
      while IFS= read -r dir || [[ -n $dir ]]; do system+=$dir:; done <"$file"
    done
    IFS=: read -r -a dirs <<<"$PATH"
    for dir in ${dirs[@]+"${dirs[@]}"}; do
      [[ -n $dir && $system != *":$dir:"* ]] || continue
      [[ ":${DOTKIT_TOOL_PATH-}:" != *":$dir:"* ]] || break
      _dotkit_first+=$dir:
    done
  }
  _dotkit_profile_first
  unset -f _dotkit_profile_first
fi

if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# Secrets that stay out of every repository: export lines in ~/.secrets.
if [[ -r ~/.secrets ]]; then
  # shellcheck source=/dev/null
  . ~/.secrets
fi

if [[ -r ~/.bash_profile.local ]]; then
  # shellcheck source=/dev/null
  . ~/.bash_profile.local
fi

# Nix owns the global CLIs. mise owns the runtimes and overrides them inside a
# project. Without repeats, empty entries, and the mise shims: `mise activate`
# supplies the tools.
_dotkit_profile_path() {
  local new=: dir
  local -a dirs
  IFS=: read -r -a dirs <<<"$_dotkit_first${DOTKIT_TOOL_PATH-}:$PATH"
  for dir in ${dirs[@]+"${dirs[@]}"}; do
    [[ -n $dir && $dir != "$HOME/.local/share/mise/shims" && $new != *":$dir:"* ]] || continue
    new+=$dir:
  done
  new=${new#:}
  PATH=${new%:}
}
_dotkit_profile_path
unset -f _dotkit_profile_path
unset _dotkit_first
export PATH
export __DOTKIT_PROFILE_DONE=1

# dotkit has no ~/.bashrc, so activate mise in interactive shells too. When a
# parent shell activated mise (MISE_SHELL), its tools are in PATH already;
# activating again would put the global versions before the tools of the
# project.
if [[ -z ${MISE_SHELL-} ]] && command -v mise >/dev/null; then
  eval "$(mise activate bash)"
fi

# bash reads only this file of a login shell, so read ~/.bashrc, as usual.
if [[ $- == *i* && -r ~/.bashrc ]]; then
  # shellcheck source=/dev/null
  . ~/.bashrc
fi
