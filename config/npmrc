# dotkit base: npm reads it as its global config (NPM_CONFIG_GLOBALCONFIG),
# before ~/.npmrc. Your settings and registry tokens go in config/npmrc of the
# dotfiles repository, linked as ~/.npmrc, and win over these. Write each token
# as a variable, //npm.pkg.github.com/:_authToken=${GITHUB_NPM_TOKEN}, and
# export it in ~/.secrets. `npm config ls` shows where each setting comes from.

# Delay newly published packages for 7 days.
min-release-age=7

# Global packages stay outside the read-only Nix store. ~/.local/bin is on PATH.
prefix=${HOME}/.local
