{
 "argv": [
  "remove",
  "-y",
  "zed"
 ],
 "exit": 0,
 "stdout": "zed: remove zed from nix/casks.txt\n",
 "stderr": "Building the system...\nActivating the system...\nInstalling the mise tools...\nRemoved zed.\n",
 "files": {
  "repo/.build/system": "-> @SB/system-1",
  "repo/nix/casks.txt": ""
 },
 "calls": [
  {
   "tool": "nix",
   "argv": [
    "build",
    "path:@SB/repo/nix#darwinConfigurations.mac.system",
    "--out-link",
    "@SB/repo/.build/system"
   ],
   "cwd": "@SB/home",
   "env": {
    "DOTFILES": "@SB/repo"
   }
  },
  {
   "tool": "sudo",
   "argv": [
    "-H",
    "/usr/bin/env",
    "NIX_REMOTE=daemon",
    "@SB/system-1/sw/bin/nix-env",
    "-p",
    "/nix/var/nix/profiles/system",
    "--set",
    "@SB/system-1"
   ],
   "cwd": "@SB/home",
   "env": {
    "DOTFILES": "@SB/repo"
   }
  },
  {
   "tool": "sudo",
   "argv": [
    "@SB/system-1/sw/bin/darwin-rebuild",
    "activate"
   ],
   "cwd": "@SB/home",
   "env": {
    "DOTFILES": "@SB/repo"
   }
  },
  {
   "tool": "mise",
   "argv": [
    "install"
   ],
   "cwd": "@SB/home",
   "env": {
    "DOTFILES": "@SB/repo"
   }
  },
  {
   "tool": "brew",
   "argv": [
    "list",
    "--cask",
    "zed"
   ],
   "cwd": "@SB/home",
   "env": {
    "DOTFILES": "@SB/repo",
    "HOMEBREW_NO_AUTO_UPDATE": "1"
   }
  },
  {
   "tool": "brew",
   "argv": [
    "uninstall",
    "--cask",
    "zed"
   ],
   "cwd": "@SB/home",
   "env": {
    "DOTFILES": "@SB/repo",
    "HOMEBREW_NO_AUTO_UPDATE": "1"
   }
  }
 ],
 "tmp_left": 0
}
