{
 "argv": [
  "add",
  "-y",
  "dkt-tool"
 ],
 "exit": 0,
 "stdout": "dkt-tool: nix:dkt-tool -> nix/packages.txt (Nixpkgs has the current release)\n  ✓ nix:dkt-tool                   1.2.0          From Nixpkgs\n    mise:dkt-tool                  1.2.0          mise\n",
 "terminal": "",
 "files": {
  "repo/.build/system": "-> @SB/system-1",
  "repo/nix/packages.txt": "jq\ndkt-tool\n"
 },
 "calls": [
  {
   "tool": "sudo",
   "argv": [
    "-H",
    "/usr/bin/env",
    "NIX_REMOTE=daemon",
    "@SB/system-1/sw/bin/nix-env",
    "-p",
    "/nix/var/nix/profiles/system",
    "--set",
    "@SB/system-1"
   ],
   "cwd": "@SB/home",
   "env": {
    "DOTFILES": "@SB/repo"
   }
  },
  {
   "tool": "curl",
   "argv": [
    "-fsSL",
    "--max-time",
    "10",
    "https://pypi.org/pypi/dkt-tool/json"
   ],
   "cwd": "@SB/home",
   "env": {
    "DOTFILES": "@SB/repo"
   }
  },
  {
   "tool": "curl",
   "argv": [
    "-fsSL",
    "--max-time",
    "10",
    "https://registry.npmjs.org/dkt-tool/latest"
   ],
   "cwd": "@SB/home",
   "env": {
    "DOTFILES": "@SB/repo"
   }
  },
  {
   "tool": "sudo",
   "argv": [
    "@SB/system-1/sw/bin/darwin-rebuild",
    "activate"
   ],
   "cwd": "@SB/home",
   "env": {
    "DOTFILES": "@SB/repo"
   }
  },
  {
   "tool": "nix",
   "argv": [
    "build",
    "path:@SB/repo/nix#darwinConfigurations.mac.system",
    "--out-link",
    "@SB/repo/.build/system"
   ],
   "cwd": "@SB/home",
   "env": {
    "DOTFILES": "@SB/repo"
   }
  },
  {
   "tool": "nix",
   "argv": [
    "eval",
    "--impure",
    "--expr",
    "builtins.compareVersions (builtins.getEnv \"DOTKIT_VERSION_A\") (builtins.getEnv \"DOTKIT_VERSION_B\")"
   ],
   "cwd": "@SB/home",
   "env": {
    "DOTFILES": "@SB/repo",
    "DOTKIT_VERSION_A": "1.2.0",
    "DOTKIT_VERSION_B": "1.2.0"
   }
  },
  {
   "tool": "nix",
   "argv": [
    "eval",
    "--json",
    "path:@SB/repo/nix#darwinConfigurations.mac.pkgs",
    "--apply",
    "\n    pkgs:\n    let\n      lib = pkgs.lib;\n      p = lib.attrByPath (lib.splitString \".\" \"dkt-tool\") null pkgs;\n      info = {\n        version = p.version or \"\";\n        description = p.meta.description or \"\";\n        bin = p.meta.mainProgram or (p.pname or \"\");\n      };\n      r = builtins.tryEval (\n        if lib.isDerivation p && (p.meta.available or true)\n        then builtins.deepSeq info info else null\n      );\n    in if r.success then r.value else null"
   ],
   "cwd": "@SB/home",
   "env": {
    "DOTFILES": "@SB/repo"
   }
  },
  {
   "tool": "brew",
   "argv": [
    "info",
    "--json=v2",
    "--cask",
    "dkt-tool"
   ],
   "cwd": "@SB/home",
   "env": {
    "DOTFILES": "@SB/repo",
    "HOMEBREW_NO_AUTO_UPDATE": "1"
   }
  },
  {
   "tool": "brew",
   "argv": [
    "info",
    "--json=v2",
    "--formula",
    "dkt-tool"
   ],
   "cwd": "@SB/home",
   "env": {
    "DOTFILES": "@SB/repo",
    "HOMEBREW_NO_AUTO_UPDATE": "1"
   }
  },
  {
   "tool": "mise",
   "argv": [
    "install"
