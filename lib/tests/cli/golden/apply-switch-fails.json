{
 "argv": [
  "apply"
 ],
 "exit": 1,
 "stdout": "",
 "stderr": "Building the system...\nActivating the system...\nsudo: a password is required\n",
 "files": {
  "repo/.build/system": "-> @SB/system-1"
 },
 "calls": [
  {
   "tool": "nix",
   "argv": [
    "build",
    "path:@SB/repo/nix#darwinConfigurations.mac.system",
    "--out-link",
    "@SB/repo/.build/system"
   ],
   "cwd": "@SB/home",
   "env": {
    "DOTFILES": "@SB/repo"
   }
  },
  {
   "tool": "sudo",
   "argv": [
    "-H",
    "/usr/bin/env",
    "NIX_REMOTE=daemon",
    "@SB/system-1/sw/bin/nix-env",
    "-p",
    "/nix/var/nix/profiles/system",
    "--set",
    "@SB/system-1"
   ],
   "cwd": "@SB/home",
   "env": {
    "DOTFILES": "@SB/repo"
   }
  }
 ],
 "tmp_left": 0
}
