{
 "argv": [
  "own",
  "-y",
  "--release",
  "starship"
 ],
 "exit": 0,
 "stdout": "starship: remove the link of ~/.config/starship.toml from nix/home.nix, so the base file comes back; config/my-starship.toml stays in the repository\n",
 "stderr": "",
 "files": {
  "repo/.build/system": "-> @SB/system-1",
  "repo/nix/home.nix": "{\n  imports = [ ./shell.nix ];\n\n  dotkit.links = {\n    \".zshrc.local\" = \"config/zsh/zshrc\";\n  };\n}\n"
 },
 "calls": [
  {
   "tool": "nix",
   "argv": [
    "eval",
    "--raw",
    "path:@SB/repo/nix#darwinConfigurations.mac.config.environment.etc.\"dotkit/links.json\".text"
   ],
   "cwd": "@SB/home",
   "env": {
    "DOTFILES": "@SB/repo"
   }
  },
  {
   "tool": "nix",
   "argv": [
    "build",
    "path:@SB/repo/nix#darwinConfigurations.mac.system",
    "--out-link",
    "@SB/repo/.build/system"
   ],
   "cwd": "@SB/home",
   "env": {
    "DOTFILES": "@SB/repo"
   }
  },
  {
   "tool": "sudo",
   "argv": [
    "-H",
    "/usr/bin/env",
    "NIX_REMOTE=daemon",
    "@SB/system-1/sw/bin/nix-env",
    "-p",
    "/nix/var/nix/profiles/system",
    "--set",
    "@SB/system-1"
   ],
   "cwd": "@SB/home",
   "env": {
    "DOTFILES": "@SB/repo"
   }
  },
  {
   "tool": "sudo",
   "argv": [
    "@SB/system-1/sw/bin/darwin-rebuild",
    "activate"
   ],
   "cwd": "@SB/home",
   "env": {
    "DOTFILES": "@SB/repo"
   }
  },
  {
   "tool": "mise",
   "argv": [
    "install"
   ],
   "cwd": "@SB/home",
   "env": {
    "DOTFILES": "@SB/repo"
   }
  }
 ],
 "tmp_left": 0
}
