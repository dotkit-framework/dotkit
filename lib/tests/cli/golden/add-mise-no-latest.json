{
 "argv": [
  "add",
  "-n",
  "mise:dkt-tool"
 ],
 "exit": 0,
 "stdout": "mise:dkt-tool -> config/mise.toml\n  ✓ mise:dkt-tool                  ?              \n",
 "stderr": "No change. Run the command without -n to add.\n",
 "files": {},
 "calls": [
  {
   "tool": "mise",
   "argv": [
    "registry",
    "dkt-tool"
   ],
   "cwd": "@SB/home",
   "env": {
    "DOTFILES": "@SB/repo"
   }
  },
  {
   "tool": "mise",
   "argv": [
    "latest",
    "dkt-tool"
   ],
   "cwd": "@SB/home",
   "env": {
    "DOTFILES": "@SB/repo"
   }
  },
  {
   "tool": "mise",
   "argv": [
    "tool",
    "--description",
    "dkt-tool"
   ],
   "cwd": "@SB/home",
   "env": {
    "DOTFILES": "@SB/repo"
   }
  },
  {
   "tool": "nix",
   "argv": [
    "eval",
    "--json",
    "path:@SB/repo/nix#darwinConfigurations.mac.pkgs",
    "--apply",
    "\n    pkgs:\n    let\n      lib = pkgs.lib;\n      p = lib.attrByPath (lib.splitString \".\" \"dkt-tool\") null pkgs;\n      info = {\n        version = p.version or \"\";\n        description = p.meta.description or \"\";\n        bin = p.meta.mainProgram or (p.pname or \"\");\n      };\n      r = builtins.tryEval (\n        if lib.isDerivation p && (p.meta.available or true)\n        then builtins.deepSeq info info else null\n      );\n    in if r.success then r.value else null"
   ],
   "cwd": "@SB/home",
   "env": {
    "DOTFILES": "@SB/repo"
   }
  },
  {
   "tool": "mise",
   "argv": [
    "which",
    "dkt-tool"
   ],
   "cwd": "@SB/home",
   "env": {
    "DOTFILES": "@SB/repo"
   }
  }
 ],
 "tmp_left": 0
}
