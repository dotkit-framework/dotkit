{
 "argv": [
  "remove",
  "-y",
  "fd"
 ],
 "exit": 0,
 "stdout": "fd: remove fd from nix/packages.txt; the dotkit base keeps it (dotkit:nix/packages.txt)\n",
 "stderr": "",
 "files": {
  "repo/.build/system": "-> @SB/system-1",
  "repo/nix/packages.txt": "jq\n"
 },
 "calls": [
  {
   "tool": "nix",
   "argv": [
    "build",
    "path:@SB/repo/nix#darwinConfigurations.mac.system",
    "--out-link",
    "@SB/repo/.build/system"
   ],
   "cwd": "@SB/home",
   "env": {
    "DOTFILES": "@SB/repo"
   }
  },
  {
   "tool": "sudo",
   "argv": [
    "-H",
    "/usr/bin/env",
    "NIX_REMOTE=daemon",
    "@SB/system-1/sw/bin/nix-env",
    "-p",
    "/nix/var/nix/profiles/system",
    "--set",
    "@SB/system-1"
   ],
   "cwd": "@SB/home",
   "env": {
    "DOTFILES": "@SB/repo"
   }
  },
  {
   "tool": "sudo",
   "argv": [
    "@SB/system-1/sw/bin/darwin-rebuild",
    "activate"
   ],
   "cwd": "@SB/home",
   "env": {
    "DOTFILES": "@SB/repo"
   }
  },
  {
   "tool": "mise",
   "argv": [
    "install"
   ],
   "cwd": "@SB/home",
   "env": {
    "DOTFILES": "@SB/repo"
   }
  }
 ],
 "tmp_left": 0
}
