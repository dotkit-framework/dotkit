{
 "argv": [
  "upgrade",
  "-y",
  "nix"
 ],
 "exit": 1,
 "stdout": "  nix   dotkit                               2025-10-09 ccccccc     -> 2025-10-20 ddddddd\n",
 "stderr": "Checking Nix...\nerror: builder for '/nix/store/x.drv' failed\n",
 "files": {},
 "calls": [
  {
   "tool": "nix",
   "argv": [
    "flake",
    "update",
    "--flake",
    "path:@SB/repo/nix"
   ],
   "cwd": "@SB/home",
   "env": {
    "DOTFILES": "@SB/repo"
   }
  },
  {
   "tool": "nix",
   "argv": [
    "build",
    "path:@SB/repo/nix#darwinConfigurations.mac.system",
    "--out-link",
    "@SB/repo/.build/system"
   ],
   "cwd": "@SB/home",
   "env": {
    "DOTFILES": "@SB/repo"
   }
  }
 ],
 "tmp_left": 0
}
