#!/bin/sh
# dotkit: day-to-day commands for a Mac with dotkit. `dotkit --help` lists them.
# The dotkit command on PATH (nix/home.nix) and ./dotkit of the dotfiles
# repository run this file with DOTFILES set to the repository, so it works
# from any directory. DOTKIT_DIR selects a dotkit checkout instead of the
# release in nix/flake.lock, for work on dotkit itself.
#
# The commands are in Python (lib/dotkit, see CLI-PLAN.md). They run with the
# macOS Python of the Xcode Command Line Tools (3.9 or newer), as the
# migration wizard does, so dotkit needs nothing from Nixpkgs. Without the
# tools, /usr/bin/python3 only opens the Apple installer, so check them first.
# -I: ignore the PYTHON* variables and the user site-packages. -B: write no .pyc files.
if ! /usr/bin/xcode-select -p >/dev/null 2>&1; then
  echo 'dotkit: the Xcode Command Line Tools are missing. Install them: xcode-select --install' >&2
  exit 1
fi
exec /usr/bin/python3 -I -B "$(dirname -- "$0")/lib/run.py" dotkit "$@"
