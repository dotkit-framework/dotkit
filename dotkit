#!/bin/bash
# dotkit: day-to-day commands for a Mac with dotkit. It must work with the macOS Bash 3.2.
# The dotkit command on PATH (nix/home.nix) and ./dotkit of the dotfiles repository
# run this script with DOTFILES set to the repository, so it works from any
# directory. Paths below are in that repository unless they say dotkit.
# The tools come from three sources, and dotkit uses the same three words everywhere:
#   nix   nix/packages.txt (CLIs), nix/flake.lock (the dotkit release, which
#         pins Nixpkgs)
#   brew  nix/casks.txt, nix/brews.txt, homebrew.masApps in nix/darwin.nix
#   mise  config/mise.toml (runtimes and fast-moving CLIs)
# The dotkit base has its own lists of each kind. `dotkit add` and
# `dotkit remove` change only the lists of the dotfiles repository.
#
# DOTKIT_DIR selects a dotkit checkout instead of the release in nix/flake.lock,
# for work on dotkit itself. See scripts/nix.sh.
set -euo pipefail

[[ -n ${DOTFILES:-} ]] || { printf 'dotkit: DOTFILES is not set. Run dotkit, or ./dotkit in your dotfiles repository.\n' >&2; exit 2; }
repo=$(cd -- "$DOTFILES" && pwd -P)
dotkit=$(cd -- "$(dirname -- "$0")" && pwd -P)
# shellcheck source=scripts/nix.sh
source "$dotkit/scripts/nix.sh"
export DOTFILES=$repo

# The lock files that `upgrade nix` updates: the dotfiles lock (the dotkit
# release), and with DOTKIT_DIR the lock of the checkout (Nixpkgs and the
# other inputs). The label goes before the input names of that lock.
lock_files=("$repo/nix/flake.lock")
lock_flakes=("path:$repo/nix")
lock_labels=('')
if [[ -n $dotkit_dir ]]; then
  lock_files+=("$dotkit_dir/flake.lock")
  lock_flakes+=("git+file://$dotkit_dir")
  lock_labels+=('dotkit/')
fi

usage() {
  printf '%s\n' \
    'Usage: dotkit <command> [options]' \
    '' \
    'Daily:' \
    '  apply [-n]                  Apply the config: Nix, Homebrew, and mise.' \
    '                              -n builds and shows the changes, and changes nothing.' \
    '  upgrade [-n] [-y] [source]  Get new releases. Shows one plan, asks once, then applies.' \
    '                              source: nix, brew, mise, or a flake input (dotkit).' \
    '                              Without a source, all three.' \
    '  add [-n] [-y] <tool>...     Select the source for a tool, add it, and apply.' \
    '  remove [-n] [-y] <tool>...  Remove a tool from the config that declares it, and apply.' \
    '  info <tool>...              Where a tool is declared, its command, and its sources.' \
    '  list [nix|brew|mise]        The declared tools.' \
    '' \
    'Recovery:' \
    '  history                     The package changes of the last apply.' \
    '  rollback                    Go back to the previous Nix generation.' \
    '                              Homebrew and mise do not roll back.' \
    '  clean [-n] [-y] [age]       Delete Nix generations older than age (default 14d),' \
    '                              old Homebrew downloads, and unused mise versions.' \
    '' \
    'New Mac: see the dotkit README.' \
    '' \
    'Examples:' \
    '  dotkit add lazygit          Nix, mise, or Homebrew: dotkit add selects one' \
    '  dotkit add npm:cowsay       A prefix selects the source (dotkit add --help)' \
    '  dotkit upgrade -n           Show what is outdated' \
    '  dotkit upgrade mise         Upgrade only the mise tools' \
    '  DOTKIT_DIR=~/.dotkit dotkit apply' \
    '                              Use a dotkit checkout instead of the locked release'
}

die() { printf 'dotkit: %s\n' "$*" >&2; exit 1; }
usage_error() { printf 'dotkit: %s Use dotkit --help.\n' "$*" >&2; exit 2; }

# Run mise from $HOME, so that only the global config and settings apply.
mise_home() { (cd "$HOME" && mise "$@"); }

confirm() {
  [[ -n $yes ]] && return 0
  [[ -t 0 && -t 2 ]] || die 'confirmation needs a terminal. Use -y to continue without one.'
  local answer
  read -rp "$1 [y/N] " answer
  [[ $answer == [yY] ]]
}

build() { build_system; }
# Build as this user, then activate as root. darwin-rebuild switch would
# evaluate the flake again as root, and root cannot read the Git repository of
# another user (a git+file input such as DOTKIT_DIR).
switch() {
  build
  local system
  system=$(readlink "$result")
  sudo -H /usr/bin/env NIX_REMOTE=daemon "$system/sw/bin/nix-env" -p /nix/var/nix/profiles/system --set "$system"
  sudo "$system/sw/bin/darwin-rebuild" activate
}
brewfile() { nix_flake eval --raw "$flake#darwinConfigurations.mac.config.homebrew.brewfile"; }
mise_install() { mise_home install; }

# Show what `brew bundle cleanup` removes for the built Brewfile, when
# activation uninstalls (homebrew.onActivation.cleanup is not "none").
preview_brew_cleanup() {
  local brewfile="$repo/.build/Brewfile" output status=0
  [[ -x /opt/homebrew/bin/brew ]] || return 0
  [[ $(nix_flake eval --raw "$flake#darwinConfigurations.mac.config.homebrew.onActivation.cleanup") != none ]] || return 0
  # Use the candidate Brewfile, not the active HOMEBREW_BUNDLE_FILE.
  brewfile >"$brewfile"
  # Without redirected input, Homebrew can prompt and then do the cleanup.
  output=$(HOMEBREW_NO_AUTO_UPDATE=1 /opt/homebrew/bin/brew bundle cleanup \
    --file="$brewfile" </dev/null) || status=$?
  # Exit 1 also reports real errors. Accept it only after a complete cleanup report.
  # shellcheck disable=SC2016 # Literal Homebrew output.
  local report_end='Run `brew bundle cleanup --force` to make these changes.'
  if [[ "${output##*$'\n'}" == "$report_end" ]]; then
    # The suggested command would use the active Brewfile, not the candidate.
    output=${output%"$report_end"}
    if ((status == 1)); then status=0; fi
    # The report ends with the old downloads that `brew cleanup` deletes. The
    # apply deletes them too, but they are not packages: do not show them.
    # shellcheck disable=SC2016 # Literal Homebrew output.
    local downloads='Would `brew cleanup`:'
    if [[ $output == "$downloads"* ]]; then
      output=''
    else
      output=${output%%$'\n'"$downloads"*}
    fi
  fi
  [[ -z "$output" ]] || printf 'Homebrew removes:\n%s\n' "${output%$'\n'}"
  ((status == 0)) || die "the Homebrew cleanup preview failed with exit code $status."
}

cmd_apply() {
  (($# == 0)) || usage_error "apply takes no arguments."
  if [[ -n $dry_run ]]; then
    build
    printf 'Nix package changes:\n'
    nix store diff-closures /run/current-system "$result"
    preview_brew_cleanup
    mise_home install --dry-run
    printf 'No change. Run dotkit apply to apply.\n' >&2
    return
  fi
  switch
  mise_install
}

# --- upgrade

# Prints "INDEX<TAB>NAME" for each input of each lock file, without inputs that
# follow another one. NAME has the label of the lock file.
flake_inputs() {
  local i
  for i in "${!lock_files[@]}"; do
    jq -r --arg i "$i" --arg label "${lock_labels[i]}" \
      '.nodes.root.inputs | to_entries[] | select(.value | type == "string") | "\($i)\t\($label)\(.key)"' \
      "${lock_files[i]}"
  done
}
flake_input_names() { flake_inputs | cut -f 2 | paste -sd ' ' -; }

# Prints one plan line per flake input that changed between lock files $1 and
# $2. $3 is the label of the lock file.
lock_changes() {
  jq -r --slurpfile old "$1" --arg label "$3" '
    def info($n): ($n.locked // {}) | [(.lastModified // 0 | strftime("%Y-%m-%d")), ((.rev // "")[0:7])] | join(" ");
    .nodes as $new | .nodes.root.inputs | to_entries[]
    | select(.value | type == "string") | .value as $k
    | select(($old[0].nodes[$k].locked // {}) != ($new[$k].locked // {}))
    | [$label + .key, info($old[0].nodes[$k]), info($new[$k])] | @tsv
  ' "$2"
}

# Copies of the lock files while an upgrade runs, by index. Empty: no copy.
lock_backups=()
restore_locks() {
  local i
  for i in "${!lock_files[@]}"; do
    [[ -n ${lock_backups[i]:-} ]] || continue
    cp "${lock_backups[i]}" "${lock_files[i]}"
    rm -f "${lock_backups[i]}"
    lock_backups[i]=''
  done
}
keep_locks() {
  local i
  for i in "${!lock_files[@]}"; do
    [[ -z ${lock_backups[i]:-} ]] || rm -f "${lock_backups[i]}"
    lock_backups[i]=''
  done
}

# The names in list files: the first word of each line, without comments.
read_list() { awk '{ sub(/#.*/, "") } NF { print $1 }' "$@"; }

plan_row() { printf '  %-5s %-36s %-22s -> %s\n' "$@"; }

cmd_upgrade() {
  local a i out up_nix='' up_brew='' up_mise='' all_inputs='' selected='' nix_rows='' brew_rows='' mise_rows=''
  for a in "$@"; do
    case $a in
    nix) up_nix=1 all_inputs=1 ;;
    brew) up_brew=1 ;;
    mise) up_mise=1 ;;
    *)
      # A bare name also selects an input of the dotkit checkout: nixpkgs is dotkit/nixpkgs.
      out=$(flake_inputs | awk -F '\t' -v a="$a" '$2 == a || $2 == "dotkit/" a')
      [[ -n $out ]] ||
        usage_error "'$a' is not a source or a flake input. Use nix, brew, mise, or: $(flake_input_names)."
      up_nix=1 selected+=$out$'\n'
      ;;
    esac
  done
  [[ -n $up_nix$up_brew$up_mise ]] || up_nix=1 up_brew=1 up_mise=1
  # `nix` means all inputs, also with an input name: upgrade nix nixpkgs.
  [[ -z $all_inputs ]] || selected=''

  if [[ -n $up_nix ]]; then
    printf 'Checking Nix...\n' >&2
    trap restore_locks EXIT
    local inputs rows
    for i in "${!lock_files[@]}"; do
      # The input names for this lock file, without the label. None: all of them.
      inputs=()
      if [[ -n $selected ]]; then
        while IFS=$'\t' read -r a out; do
          [[ $a == "$i" ]] && inputs+=("${out#"${lock_labels[i]}"}")
        done <<<"${selected%$'\n'}"
        ((${#inputs[@]} > 0)) || continue
      fi
      lock_backups[i]=$(mktemp)
      cp "${lock_files[i]}" "${lock_backups[i]}"
      out=$(nix flake update ${inputs[@]+"${inputs[@]}"} --flake "${lock_flakes[i]}" 2>&1) ||
        { printf '%s\n' "$out" >&2; die "nix flake update failed for ${lock_files[i]}. The lock files are restored."; }
      rows=$(lock_changes "${lock_backups[i]}" "${lock_files[i]}" "${lock_labels[i]}")
      if [[ -n $rows ]]; then
        nix_rows+=$rows$'\n'
      else
        cp "${lock_backups[i]}" "${lock_files[i]}"
        rm -f "${lock_backups[i]}"
        lock_backups[i]=''
      fi
    done
    nix_rows=${nix_rows%$'\n'}
  fi
  if [[ -n $up_brew ]]; then
    printf 'Checking Homebrew...\n' >&2
    out=$(brew update --quiet 2>&1) || { printf '%s\n' "$out" >&2; die 'brew update failed.'; }
    # Only the declared formulae and casks: brew bundle does not upgrade the
    # others (for example dependencies, or formulae installed by hand).
    brew_rows=$(HOMEBREW_NO_AUTO_UPDATE=1 brew outdated --json=v2 |
      jq -r --rawfile declared <(read_list "$dotkit/nix/brews.txt" "$dotkit/nix/casks.txt" "$repo/nix/brews.txt" "$repo/nix/casks.txt") '
        ($declared | split("\n")) as $names
        | (.formulae[], .casks[]) | select(.name as $n | $names | index($n))
        | [.name, (.installed_versions | join(" ")), .current_version] | @tsv')
  fi
  if [[ -n $up_mise ]]; then
    printf 'Checking mise...\n' >&2
    mise_rows=$(mise_home outdated --json | jq -r 'to_entries[] | [.key, .value.current, .value.latest] | @tsv')
  fi

  if [[ -z $nix_rows$brew_rows$mise_rows ]]; then
    printf 'Everything is up to date.\n'
    return
  fi
  local src rows name from to
  for src in nix brew mise; do
    case $src in nix) rows=$nix_rows ;; brew) rows=$brew_rows ;; mise) rows=$mise_rows ;; esac
    [[ -n $rows ]] || continue
    while IFS=$'\t' read -r name from to; do plan_row "$src" "$name" "$from" "$to"; done <<<"$rows"
  done
  if [[ -n $nix_rows ]]; then
    build
    printf '\nNix package changes:\n'
    nix store diff-closures /run/current-system "$result"
  fi
  if [[ -n $dry_run ]]; then
    restore_locks
    printf 'No change. Run dotkit upgrade to apply.\n' >&2
    return
  fi
  confirm 'Upgrade?' || { restore_locks; die 'nothing changed.'; }

  if [[ -n $nix_rows ]]; then
    switch || { restore_locks; die 'the switch failed. The lock files are restored.'; }
    keep_locks
  fi
  if [[ -n $brew_rows ]]; then
    # Read the Brewfile from the flake, so it matches the config.
    brewfile | HOMEBREW_NO_INSTALL_CLEANUP=1 brew bundle install --file=-
  fi
  [[ -z $mise_rows ]] || mise_home upgrade
  if [[ -n $nix_rows ]]; then
    printf 'Commit nix/flake.lock to keep the upgrade.\n' >&2
    [[ -z $dotkit_dir ]] || printf 'Commit flake.lock in %s too, if it changed.\n' "$dotkit_dir" >&2
  fi
}

# --- recovery

# Compare the active generation with the one before it.
cmd_history() {
  (($# == 0)) || usage_error "history takes no arguments."
  local profiles=/nix/var/nix/profiles current prev
  current=$(readlink "$profiles/system")
  prev="$profiles/system-$((${current//[!0-9]/} - 1))-link"
  [[ -e $prev ]] || die 'there is no previous generation.'
  echo "${prev##*/} -> $current"
  nix store diff-closures "$prev" "$profiles/$current"
}

cmd_rollback() {
  (($# == 0)) || usage_error "rollback takes no arguments."
  sudo darwin-rebuild switch --rollback
}

cmd_clean() {
  (($# <= 1)) || usage_error "clean takes one age, for example 30d."
  local age=${1:-14d}
  [[ $age =~ ^[0-9]+d$ ]] || usage_error "'$age' is not an age. Use days, for example 30d."
  if [[ -n $dry_run ]]; then
    sudo nix-collect-garbage --delete-older-than "$age" --dry-run
    brew cleanup --dry-run
    mise_home prune --dry-run
    printf 'No change. Run dotkit clean to delete.\n' >&2
    return
  fi
  confirm "Delete Nix generations older than $age, old Homebrew downloads, and unused mise versions?" ||
    die 'nothing changed.'
  sudo nix-collect-garbage --delete-older-than "$age"
  brew cleanup
  mise_home prune --yes
}

# --- main

cmd=${1:-}
[[ -n $cmd ]] && shift

case $cmd in
add | remove | info | list) exec "$dotkit/scripts/dotkit-pkg" "$cmd" "$@" ;;
# For the zsh completion (nix/completions/_dotkit). Reads files, runs no nix.
__complete)
  case ${1:-} in
  inputs) flake_inputs | cut -f 2 ;;
  tools-user | tools-all) exec "$dotkit/scripts/dotkit-pkg" __names "${1#tools-}" ;;
  *) usage_error "__complete takes inputs, tools-user, or tools-all." ;;
  esac
  exit 0
  ;;
-h | --help | help | '') usage; exit 0 ;;
apply | upgrade | history | rollback | clean) ;;
switch) usage_error "'switch' is now 'apply'." ;;
build | diff) usage_error "'$cmd' is now 'apply -n'." ;;
update) usage_error "'update' is now 'upgrade nix' (or 'upgrade <input>')." ;;
brew) usage_error "'brew' is now 'upgrade brew'." ;;
tools) usage_error "'tools' is now 'upgrade mise'." ;;
changes) usage_error "'changes' is now 'history'." ;;
where) usage_error "'where' is now 'info'." ;;
gc) usage_error "'gc' is now 'clean'." ;;
*) usage_error "unknown command: $cmd." ;;
esac

dry_run='' yes=''
args=()
while [[ $# -gt 0 ]]; do
  case $1 in
  -n | --dry-run) dry_run=1 ;;
  -y | --yes) yes=1 ;;
  -h | --help) usage; exit 0 ;;
  --) shift; args+=("$@"); break ;;
  -*) usage_error "unknown option: $1." ;;
  *) args+=("$1") ;;
  esac
  shift
done
case $cmd in
history | rollback) [[ -z $dry_run$yes ]] || usage_error "$cmd takes no options." ;;
apply) [[ -z $yes ]] || usage_error "apply does not ask, so it takes no -y." ;;
esac

"cmd_$cmd" ${args[@]+"${args[@]}"}
