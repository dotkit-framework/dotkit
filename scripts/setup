#!/bin/bash
set -euo pipefail

usage() {
  # shellcheck disable=SC2016 # The usage shows a command to copy.
  printf '%s\n' \
    'Set up this Apple Silicon Mac with dotkit: install the missing prerequisites' \
    '(Xcode Command Line Tools, Nix, Homebrew), get the dotfiles repository, then' \
    'build and apply the configuration.' \
    '' \
    'Usage: bash -c "$(curl -fsSL https://raw.githubusercontent.com/podkovyrin/dotkit/main/scripts/setup)" setup [-y] [-n] [<repository-url>]' \
    '       ~/.dotkit/scripts/setup [-y] [-n] [<repository-url>]' \
    '' \
    'The dotfiles repository is ~/.dotfiles (DOTFILES overrides it). When it does' \
    'not exist, setup clones <repository-url>. Without one, a wizard scans this Mac,' \
    'asks a few questions, and creates the repository from the dotkit template with' \
    'what it can carry over: Homebrew packages, global npm and pipx tools, shell' \
    'lines, and config files. MIGRATION.md in the repository lists the rest.' \
    '' \
    'Run as your normal user, without sudo. Installers and activation request access.' \
    'After setup, use dotkit apply. It works from any directory.' \
    '' \
    'Options:' \
    '  -y, --yes      Install the missing prerequisites without questions, also' \
    '                 without a terminal, for example in CI. sudo must work without' \
    '                 a password. The wizard takes its defaults. Without a terminal,' \
    '                 the Git name and email come from your Git config, if it has' \
    '                 them.' \
    '  -n, --dry-run  Scan this Mac and print what the wizard would create, with the' \
    '                 report. Changes nothing, and installs nothing.' \
    '  -h, --help     Show this help.'
}

url='' yes='' dry_run=''
for arg in "$@"; do
  case $arg in
    -h|--help) usage; exit 0 ;;
    -y|--yes) yes=1 ;;
    -n|--dry-run) dry_run=1 ;;
    -*) printf 'Unknown option: %s. Use --help.\n' "$arg" >&2; exit 2 ;;
    *)
      [[ -z $url ]] || { printf 'Unknown arguments: %s. Use --help.\n' "$*" >&2; exit 2; }
      url=$arg
      ;;
  esac
done

fail() {
  printf '%s\n' "$@" >&2
  exit 1
}

[[ $(id -u) != 0 ]] || fail 'Run this command as your normal user, without sudo.'
[[ $(uname -s) == Darwin && $(uname -m) == arm64 ]] ||
  fail 'Run this setup in a native Apple Silicon macOS shell.'
macos=$(/usr/bin/sw_vers -productVersion)
(( ${macos%%.*} >= 14 )) || fail 'This setup requires macOS 14 or newer.'

repo=${DOTFILES:-$HOME/.dotfiles}
flake="path:$repo/nix"
build="$repo/.build"
override=()
[[ -z ${DOTKIT_DIR:-} ]] || override=(--override-input dotkit "git+file://$(cd -- "$DOTKIT_DIR" && pwd -P)" --no-write-lock-file --option warn-dirty false)

may_install() {
  [[ -n $yes || ( -t 0 && -t 2 ) ]] ||
    fail "Installing $1 requires an interactive terminal. Run the setup there, or use --yes."
}

ensure_clt() {
  /usr/bin/xcode-select -p >/dev/null 2>&1 && return
  [[ -z $dry_run ]] || fail 'The dry run needs the Xcode Command Line Tools. It installs nothing.'
  may_install 'Xcode Command Line Tools'
  printf 'Requesting Xcode Command Line Tools. Complete the Apple installer dialog.\n' >&2
  /usr/bin/xcode-select --install
  printf 'Waiting up to 15 minutes for the developer tools. Interrupt to stop waiting.\n' >&2
  for _ in {1..180}; do
    /usr/bin/xcode-select -p >/dev/null 2>&1 && return
    sleep 5
  done
  fail 'Developer tools are not ready. Finish the Apple installation, then run the setup again.'
}

find_nix() {
  command -v nix || { [[ -x /nix/var/nix/profiles/default/bin/nix ]] &&
    printf '%s\n' /nix/var/nix/profiles/default/bin/nix; }
}

ensure_nix() {
  [[ ! -e /usr/local/bin/determinate-nixd ]] ||
    fail 'Determinate manages this Nix daemon. This configuration requires nix-darwin daemon ownership.' \
      'Resolve the daemon ownership manually. No replacement or installation ran.'
  find_nix >/dev/null && return
  may_install Nix

  # Keep this at the version of nix.package in nix/darwin.nix
  # (pkgs.nixVersions.latest in the locked Nixpkgs). nix-darwin replaces the
  # installed Nix with that one, and a downgrade is not supported. The binary
  # tarball and its hash are the ones that releases.nixos.org/nix/<version>/install
  # downloads for aarch64-darwin.
  local name='nix-2.35.2-aarch64-darwin'
  local url="https://releases.nixos.org/nix/nix-2.35.2/$name.tar.xz"
  local sha256='1695c13aba5afa7c2ecd6dc4a9393f602e7bbc440ed45e81602c831546580ec3'
  # Not in $repo: ensure_dotfiles runs later and needs $repo not to exist yet.
  local tarball="$HOME/Library/Caches/dotkit/$name.tar.xz"
  mkdir -p "${tarball%/*}"
  if [[ $(/usr/bin/shasum -a 256 "$tarball" 2>/dev/null) != "$sha256 "* ]]; then
    printf 'Downloading the pinned Nix release.\n' >&2
    /usr/bin/curl --fail --silent --show-error --location --proto '=https' --tlsv1.2 \
      --output "$tarball.partial" "$url"
    [[ $(/usr/bin/shasum -a 256 "$tarball.partial") == "$sha256 "* ]] || {
      rm -f "$tarball.partial"
      fail 'SHA256 mismatch for the Nix release. The installer was not executed.'
    }
    mv -f "$tarball.partial" "$tarball"
  fi
  local unpack
  unpack=$(mktemp -d)
  /usr/bin/tar -xJf "$tarball" -C "$unpack"

  # The installer adds its lines to /etc/zshrc and /etc/bashrc with
  # { lines; cat FILE; } | sudo tee FILE. tee can empty FILE before cat reads
  # it: then the file loses its macOS lines, or cat fails on the compressed
  # file and the installation stops halfway. Read the copy
  # FILE.backup-before-nix that the installer makes just before.
  local script="$unpack/$name/install-multi-user" old new
  # shellcheck disable=SC2016 # Lines of the installer, not to expand.
  old='cat "$profile_target"'
  # shellcheck disable=SC2016
  new='if [ -e "$profile_target$PROFILE_BACKUP_SUFFIX" ]; then cat "$profile_target$PROFILE_BACKUP_SUFFIX"; fi'
  /usr/bin/awk -v old="$old" -v new="$new" '
    { line = $0; sub(/^ +/, "", line) }
    line == old { $0 = substr($0, 1, length($0) - length(line)) new; n++ }
    { print }
    END { exit n != 1 }
  ' "$script" >"$script.patched" || {
    rm -rf "$unpack"
    fail 'The Nix installer does not have the expected profile code. The installer was not executed.'
  }
  cat "$script.patched" >"$script"

  printf 'Installing official multi-user Nix. Follow its administrator prompts.\n' >&2
  local args=(--daemon --no-channel-add) status=0
  [[ -z $yes ]] || args+=(--yes)
  (
    unset CI NONINTERACTIVE NIX_INSTALLER_YES
    "$unpack/$name/install" "${args[@]}"
  ) || status=$?
  rm -rf "$unpack"
  (( status == 0 )) || exit "$status"
  find_nix >/dev/null ||
    fail 'The installer finished, but Nix was not found. Inspect its output before retrying.'
}

# A Homebrew in another prefix, for example the Intel one in /usr/local. Setup
# checks it before it installs anything.
homebrew=/opt/homebrew/bin/brew intel_homebrew=/usr/local/bin/brew
check_brew_prefix() {
  [[ -x $homebrew ]] && return
  local existing
  existing=$(command -v brew) || existing=''
  [[ -n $existing || ! -x $intel_homebrew ]] || existing=$intel_homebrew
  [[ -z $existing ]] ||
    fail "This configuration requires Homebrew at /opt/homebrew. Existing executable: $existing" \
      'Resolve the Homebrew prefix manually. Setup installed nothing.'
}

ensure_brew() {
  [[ -x /opt/homebrew/bin/brew ]] && return
  check_brew_prefix
  may_install Homebrew

  local installer developer status=0
  installer=$(/usr/bin/curl --fail --silent --show-error --location --proto '=https' --tlsv1.2 \
    'https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh')
  developer=$(/usr/bin/xcode-select -p)
  printf 'Installing Homebrew at /opt/homebrew. Follow its administrator prompts.\n' >&2
  (
    unset CI NONINTERACTIVE NIX_INSTALLER_YES
    [[ -z $yes ]] || export NONINTERACTIVE=1
    /bin/bash -c "$installer"
  ) || status=$?
  # Homebrew can install CLT and select it even when full Xcode is active.
  if [[ $(/usr/bin/xcode-select -p) != "$developer" ]]; then
    printf 'Restoring the selected Apple developer directory: %s\n' "$developer" >&2
    sudo /usr/bin/xcode-select --switch "$developer"
  fi
  (( status == 0 )) || exit "$status"
  [[ -x /opt/homebrew/bin/brew ]] ||
    fail 'The installer finished, but /opt/homebrew/bin/brew is missing. Inspect its output before retrying.'
}

ensure_git_user() {
  local file="$HOME/.gitconfig.user" name email old_name old_email
  [[ -e "$file" ]] && return
  # The identity of the Git config from before dotkit, as the default.
  old_name=$(git config --global --includes --get user.name 2>/dev/null) || old_name=''
  old_email=$(git config --global --includes --get user.email 2>/dev/null) || old_email=''
  if [[ ! -t 0 ]]; then
    if [[ -z $old_name || -z $old_email ]]; then
      printf 'Skipping %s: no interactive terminal. Run the setup there to create it.\n' "$file" >&2
      return
    fi
    name=$old_name email=$old_email
  else
    printf 'Creating %s for your Git identity.\n' "$file" >&2
    read -rp "Name [${old_name:-$(id -F)}]: " name
    name=${name:-${old_name:-$(id -F)}}
    read -rp "Email${old_email:+ [$old_email]}: " email
    email=${email:-$old_email}
    while [[ -z "${email:-}" ]]; do read -rp 'Email: ' email; done
  fi

  git config --file "$file" user.name "$name"
  git config --file "$file" user.email "$email"
  printf 'Wrote %s.\n' "$file" >&2
}

# The migration wizard (migrate/ of dotkit), with the macOS Python of the
# Xcode Command Line Tools. It scans this Mac, asks a few questions, and writes
# the new repository from the dotkit template, with MIGRATION.md. It changes
# nothing else.
migrate() {
  "$dotkit/migrate/dotkit-migrate" setup --repo "$repo" ${yes:+--yes} "$@"
}

# True when $1 does not exist, or is an empty directory (for example one
# that the user made for the repository). Setup uses that path as new.
is_absent() {
  [[ ! -e $1 && ! -L $1 ]] && return
  [[ -d $1 && ! -L $1 && -z $(ls -A -- "$1") ]]
}

# Git treats an argument without :// and without a colon before the first
# slash as a local path.
is_local_path() {
  [[ $1 != *://* ]] || return 1
  [[ $1 != *:* || ${1%%:*} == */* ]]
}

# Setup clones <repository-url> to $repo. A local path must be a Git
# repository other than $repo: a common mistake is to give the destination.
check_url() {
  [[ -n $url ]] && is_local_path "$url" || return 0
  local hint="<repository-url> is the dotfiles repository that setup clones to $repo (DOTFILES sets another path). To create a new repository, run setup without it."
  [[ -d $url && -d $repo && $(cd -- "$url" && pwd -P) == "$(cd -- "$repo" && pwd -P)" ]] &&
    fail "$url is the destination of setup, not a repository to clone." "$hint"
  git -C "$url" rev-parse --git-dir >/dev/null 2>&1 ||
    fail "$url is not a Git repository." "$hint"
}

# The dotfiles repository: the existing one, a clone of $url, or a new one
# from the migration wizard. The wizard can choose another path.
ensure_dotfiles() {
  if is_absent "$repo"; then
    [[ ! -d $repo ]] || rmdir -- "$repo"
  else
    [[ -f $repo/nix/flake.nix ]] ||
      fail "$repo exists, but has no nix/flake.nix. Move it, or set DOTFILES."
    return
  fi
  if [[ -n $url ]]; then
    git clone "$url" "$repo"
    return
  fi

  [[ $repo == "$HOME/"* ]] || fail "$repo is not in $HOME. Use a directory in your home directory."
  local result
  result=$(mktemp)
  migrate --result "$result" || { rm -f "$result"; fail 'Setup stopped. The repository was not created.'; }
  read -r repo <"$result"
  rm -f "$result"
  flake="path:$repo/nix"
  build="$repo/.build"
  # For a run after a failure: the wizard can choose another path than ~/.dotfiles.
  mkdir -p "${created%/*}"
  printf '%s\n' "$repo" >"$created"
  printf 'Read %s/MIGRATION.md, commit the repository, and push it to your own remote.\n' "$repo" >&2
}

# The repository that the wizard created in an earlier run that failed.
created="$HOME/Library/Caches/dotkit/repository"
find_created_repo() {
  local earlier
  [[ -z ${DOTFILES:-} && -z $url && -f $created ]] && is_absent "$repo" || return 0
  read -r earlier <"$created" || return 0
  [[ -f $earlier/nix/flake.nix ]] || return 0
  repo=$earlier flake="path:$earlier/nix" build="$earlier/.build"
  printf 'Using %s, which an earlier run of setup created. Set DOTFILES for another one.\n' "$repo" >&2
}

# The Nix installer puts its lines at the start of /etc/zshrc and /etc/bashrc
# and keeps the original as <name>.backup-before-nix. nix-darwin replaces a
# file in /etc only when it knows its content, so the first activation would
# stop. When the file is the original plus these lines, move it to
# <name>.before-nix-darwin, the backup that nix-darwin makes itself (its
# uninstaller restores it). Otherwise leave it, and nix-darwin explains.
# moved lists the files that this run moved.
moved=()
move_nix_installer_etc() {
  local name file
  for name in zshrc bashrc; do
    file=/etc/$name
    [[ -f $file && ! -L $file && -f $file.backup-before-nix && ! -e $file.before-nix-darwin ]] || continue
    # The file without the lines from "# Nix" to "# End Nix" and one blank line
    # on each side.
    /usr/bin/awk '
      state == 0 && $0 == "# Nix" { blank = 0; state = 1; next }
      state == 1 { if ($0 == "# End Nix") state = 2; next }
      state == 2 { state = 3; if ($0 == "") next }
      state == 0 && $0 == "" { if (blank) print ""; blank = 1; next }
      { if (blank) print ""; blank = 0; print }
      END { if (blank) print "" }
    ' "$file" | /usr/bin/cmp -s - "$file.backup-before-nix" || continue
    printf 'Moving %s, the macOS file with the lines of the Nix installer, to %s.\n' "$file" "$file.before-nix-darwin" >&2
    sudo /bin/mv "$file" "$file.before-nix-darwin"
    moved+=("$file")
  done
}

# Home Manager renames a file in the way of a link to <name>.before-dotkit,
# but stops at a link that is not its own, for example one of GNU Stow, also
# one at a directory above the file. The wizard lists those links in
# .build/links-in-way of the repository, relative to the home directory, so a
# run after a failure finds them too. moved_links lists the ones that this run
# moved.
moved_links=()
move_links_in_way() {
  local rel file
  [[ -f $build/links-in-way ]] || return 0
  while IFS= read -r rel; do
    [[ -n $rel ]] || continue
    file=$HOME/$rel
    [[ -L $file && $(readlink "$file") != /nix/store/* && ! -e $file.before-dotkit && ! -L $file.before-dotkit ]] ||
      continue
    printf 'Moving the link %s to %s.\n' "$file" "$file.before-dotkit" >&2
    mv "$file" "$file.before-dotkit"
    moved_links+=("$file")
  done <"$build/links-in-way"
}

restore_links() {
  local file
  for file in ${moved_links[@]+"${moved_links[@]}"}; do
    [[ -e $file || -L $file ]] || mv "$file.before-dotkit" "$file"
  done
}

# When the activation fails, move back each file that this run moved and that
# nix-darwin did not replace, so that new shells still load Nix.
restore_nix_installer_etc() {
  local file restored=()
  for file in ${moved[@]+"${moved[@]}"}; do
    [[ ! -e $file && ! -L $file && -f $file.before-nix-darwin ]] || continue
    sudo /bin/mv "$file.before-nix-darwin" "$file"
    restored+=("$file")
  done
  [[ ${#restored[@]} == 0 ]] ||
    printf 'Moved %s back. Fix the problem above, then run setup again.\n' "${restored[*]}" >&2
}

# Until the activation succeeds, an exit (also Ctrl-C at a sudo prompt) moves
# back what this run moved aside. After a failure, it shows how to run setup
# again with the repository that the wizard created.
default_repo=$repo activated=''
on_exit() {
  local status=$?
  if [[ -z $activated ]]; then
    restore_links
    restore_nix_installer_etc
  fi
  if (( status != 0 )) && [[ $repo != "$default_repo" && -f $repo/nix/flake.nix ]]; then
    printf 'The repository is %s. To continue, run setup again with it:\n  DOTFILES=%q %q%s\n' \
      "$repo" "$repo" "$dotkit/scripts/setup" "${yes:+ --yes}" >&2
  fi
}

# tests/setup.sh sources this file for its functions, without running setup.
[[ -z ${DOTKIT_SETUP_TEST:-} ]] || return 0

ensure_clt

# Run through curl, not from a file: clone dotkit, then run its copy of this script.
if [[ -z "${BASH_SOURCE[0]:-}" ]]; then
  dir=$(mktemp -d)/dotkit
  git clone --quiet --depth 1 https://github.com/podkovyrin/dotkit.git "$dir"
  exec "$dir/scripts/setup" "$@"
fi
dotkit=$(cd -- "$(dirname -- "$0")/.." && pwd -P)

# The dry run: the wizard prints the repository that it would create, and
# the report. Nothing is installed or written.
if [[ -n $dry_run ]]; then
  [[ -z $url ]] || fail 'The dry run is for a new repository, without <repository-url>.'
  is_absent "$repo" || fail "$repo exists. The dry run shows a new repository: set DOTFILES to another path."
  [[ ! -d $repo ]] || fail "$repo is an empty directory. Remove it for the dry run, or set DOTFILES to another path."
  migrate --dry-run
  exit
fi

trap on_exit EXIT
trap 'exit 130' INT TERM HUP

check_url
check_brew_prefix
find_created_repo
ensure_git_user
ensure_nix
nix_bin=$(find_nix)
PATH="$(dirname -- "$nix_bin"):$PATH"
export PATH
nix=("$nix_bin" --extra-experimental-features 'nix-command flakes')
ensure_dotfiles

# shellcheck disable=SC2016 # A Nix expression.
declared=$("${nix[@]}" eval --raw --file "$repo/nix/user.nix" \
  --apply 'user: "${user.name}\n${user.home}\n${user.dotfiles}"')
{ read -r user_name; read -r user_home; read -r user_dotfiles; } <<<"$declared"
[[ "$(id -un)" == "$user_name" && "$HOME" == "$user_home" ]] ||
  fail "Run as $user_name with HOME=$user_home, or edit $repo/nix/user.nix."
[[ "$(cd -- "$repo" && pwd -P)" == "$user_dotfiles" ]] ||
  fail "Use the checkout at $user_dotfiles, or edit $repo/nix/user.nix."

printf 'Building the Mac configuration...\n' >&2
"${nix[@]}" build "$flake#darwinConfigurations.mac.system" --out-link "$build/system" ${override[@]+"${override[@]}"}

ensure_brew
printf 'Activating the configuration. Administrator access is required.\n' >&2
# Use nix-env and darwin-rebuild from the built system, so a first run needs no
# installed copy. darwin-rebuild switch would evaluate the flake again as root.
system=$(readlink "$build/system")
move_nix_installer_etc
move_links_in_way
status=0
{
  sudo -H /usr/bin/env NIX_REMOTE=daemon "$system/sw/bin/nix-env" -p /nix/var/nix/profiles/system --set "$system" &&
    sudo "$system/sw/bin/darwin-rebuild" activate
} || status=$?
if (( status != 0 )); then
  restore_nix_installer_etc
  restore_links
  exit "$status"
fi
activated=1
rm -f "$build/links-in-way"
# Global mise tools: the dotkit base and config/mise.toml of the dotfiles repository.
printf 'Installing global mise tools...\n' >&2
(cd "$HOME" && PATH="/etc/profiles/per-user/$user_name/bin:$PATH" mise install)
printf 'Setup complete. Open a new terminal. From now on, use dotkit apply.\n' >&2
